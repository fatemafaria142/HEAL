# Copy this file to .env and fill in real values. .env is gitignored; never commit it.

# Required. OpenAI API key used by every HEAL agent (read directly by langchain-openai).
OPENAI_API_KEY=sk-your-key-here

# Required. PostgreSQL connection string for the clinical database (see database/import_db.py).
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/<db>

# Optional. One of the three backbones evaluated in the paper: gpt-4o-mini, gpt-5-nano, gpt-5-mini.
# Must have a matching entry in config.LLM_PRICING for cost tracking to work.
OPENAI_MODEL=gpt-5-mini

# Optional feature flags (default shown; see config.py for the full list).
# HEAL_REFRESH_SCHEMA_EACH_QUERY=false
# HEAL_CIP_DETERMINISTIC_CLARIFY=true
# HEAL_CIP_STRICT_INTERVIEWER=false
# HEAL_LEGACY_DOMAIN_REGEX=false
# HEAL_CROSS_AGENT_VALIDATION=true
# HEAL_CAV_LLM_ON_CRITICAL=true
# HEAL_CAV_MAX_REPAIRS=1
# HEAL_CAV_SELF_VERIFY=true
# HEAL_SQL_SCHEMA_GUARD=true
# HEAL_RELIABILITY_SNAPSHOTS=true
# HEAL_COST_TRACKING=true
# HEAL_OUTPUT_DIR=output
